# ==============================================================================
# Clinic Stock Console - Environment Configuration
# ==============================================================================
# Default API endpoint for DummyJSON (free public REST API)
NEXT_PUBLIC_API_URL=https://dummyjson.com

# Production Application URL (used for absolute metadata / redirection)
NEXT_PUBLIC_APP_URL=https://savannah-informatics-eight.vercel.app

# Vercel Deployment Secrets (Required for CI/CD GitHub Actions: deploy.yml)
# Set these in GitHub Repository Secrets (Settings -> Secrets and variables -> Actions)
# VERCEL_TOKEN=your_vercel_cli_token
# VERCEL_ORG_ID=your_vercel_org_id
# VERCEL_PROJECT_ID=your_vercel_project_id
